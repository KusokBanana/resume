---
/**
 * Переключатель языка RU/EN. Кнопки переключают data-lang на <html> (CSS
 * показывает нужные .lang-ru/.lang-en) и запоминают выбор в localStorage —
 * тот же ключ, что читает инлайн-скрипт в <head> лендинга (без мигания).
 * `aria-pressed` отражает активный язык для скринридеров.
 */
---

<div class="lang-toggle" role="group" aria-label="Language">
  <button type="button" data-set-lang="ru" aria-pressed="false">RU</button>
  <button type="button" data-set-lang="en" aria-pressed="false">EN</button>
</div>

<script>
  // Бандлится Astro. Раскладку и анти-мигание задаёт инлайн-скрипт в <head>;
  // здесь только реакция на клики + синхронизация aria-pressed.
  const html = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-lang]');
  const sync = (lang: string) => {
    buttons.forEach((b) => {
      b.setAttribute('aria-pressed', b.dataset.setLang === lang ? 'true' : 'false');
    });
  };
  buttons.forEach((b) => {
    b.addEventListener('click', () => {
      const lang = b.dataset.setLang;
      if (!lang) return;
      html.dataset.lang = lang;
      html.setAttribute('lang', lang);
      try {
        localStorage.setItem('landing-lang', lang);
      } catch {
        /* приватный режим — просто не запоминаем выбор */
      }
      sync(lang);
    });
  });
  // Начальное состояние — по языку, выставленному head-скриптом.
  sync(html.dataset.lang || 'ru');
</script>
