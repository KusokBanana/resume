---
import { withBase } from '../lib/url';
import { renderInline } from '../lib/inline';
import { dateRange, durationLabel } from '../lib/labels';
import Bilingual from './Bilingual.astro';
import StackLine from './StackLine.astro';
import type { Experience } from '../schema/index';

interface Props {
  e: Experience;
  base: string;
}
const { e, base } = Astro.props;

// Превью: первые N плоских пунктов видны всегда; остальное (хвост плоских пунктов,
// все группы, стек) уходит под сворачивание. Группы НЕ дробим — так заголовки
// подсекций остаются осмысленными.
const LEAD = 3;
const lead = e.highlights.slice(0, LEAD);
const restHighlights = e.highlights.slice(LEAD);
const groupBullets = e.groups.reduce((n, g) => n + g.highlights.length, 0);
const hiddenCount = restHighlights.length + groupBullets;
const hasCollapse = hiddenCount > 0;
---

<article class="tl-item reveal" id={`exp-${e.id}`}>
  <h3 class="tl-role">
    <Bilingual ru={e.role.ru} en={e.role.en} />
  </h3>
  <p class="tl-company">
    {e.logo && <img class="tl-logo" src={withBase(base, e.logo)} alt="" loading="lazy" />}
    {
      e.companyUrl ? (
        <a href={e.companyUrl} target="_blank" rel="noopener noreferrer">
          {e.company}
        </a>
      ) : (
        e.company
      )
    }
    {
      e.industry && (
        <span class="tl-industry">
          <Bilingual ru={e.industry.ru} en={e.industry.en} />
        </span>
      )
    }
  </p>
  <p class="tl-meta">
    <Bilingual ru={dateRange(e.start, e.end, 'ru')} en={dateRange(e.start, e.end, 'en')} />
    <Bilingual
      class="tl-duration"
      ru={durationLabel(e.start, e.end, 'ru')}
      en={durationLabel(e.start, e.end, 'en')}
    />
    {
      e.location && (
        <>
          {' · '}
          <Bilingual ru={e.location.ru} en={e.location.en} />
        </>
      )
    }
  </p>
  {
    e.metrics.length > 0 && (
      <div class="tl-metrics">
        {e.metrics.map((m) => (
          <Bilingual class="tl-metric" html ru={renderInline(m.ru)} en={renderInline(m.en)} />
        ))}
      </div>
    )
  }
  {
    e.summary && (
      <p class="tl-summary">
        <Bilingual ru={e.summary.ru} en={e.summary.en} />
      </p>
    )
  }
  {
    lead.length > 0 && (
      <ul class="tl-points">
        {lead.map((h) => (
          <Bilingual as="li" html ru={renderInline(h.text.ru)} en={renderInline(h.text.en)} />
        ))}
      </ul>
    )
  }

  {
    hasCollapse && (
      <div class="tl-rest">
        {restHighlights.length > 0 && (
          <ul class="tl-points">
            {restHighlights.map((h) => (
              <Bilingual as="li" html ru={renderInline(h.text.ru)} en={renderInline(h.text.en)} />
            ))}
          </ul>
        )}
        {e.groups.map((g) => (
          <div class="tl-group">
            <h4>
              <Bilingual ru={g.title.ru} en={g.title.en} />
            </h4>
            <ul class="tl-points">
              {g.highlights.map((h) => (
                <Bilingual as="li" html ru={renderInline(h.text.ru)} en={renderInline(h.text.en)} />
              ))}
            </ul>
          </div>
        ))}
        <StackLine stack={e.stack} />
      </div>
    )
  }

  {
    hasCollapse && (
      <button class="tl-toggle" type="button" aria-expanded="false">
        <span class="tl-toggle-more">
          <Bilingual ru={`Показать ещё ${hiddenCount}`} en={`Show ${hiddenCount} more`} />
        </span>
        <span class="tl-toggle-less">
          <Bilingual ru="Свернуть" en="Collapse" />
        </span>
        <span class="tl-chevron" aria-hidden="true">▾</span>
      </button>
    )
  }

  {!hasCollapse && <StackLine stack={e.stack} />}
</article>
