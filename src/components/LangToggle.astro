---
/**
 * Переключатель языка RU/EN. Кнопки переключают data-lang на <html> (CSS
 * показывает нужные .lang-ru/.lang-en) и запоминают выбор в localStorage —
 * тот же ключ, что читает инлайн-скрипт в <head> лендинга (без мигания).
 */
---
<div class="lang-toggle" role="group" aria-label="Language">
  <button type="button" data-set-lang="ru">RU</button>
  <button type="button" data-set-lang="en">EN</button>
</div>

<script is:inline>
  (function () {
    var html = document.documentElement;
    document.querySelectorAll('[data-set-lang]').forEach(function (b) {
      b.addEventListener('click', function () {
        var l = b.getAttribute('data-set-lang');
        html.dataset.lang = l;
        html.setAttribute('lang', l);
        try {
          localStorage.setItem('landing-lang', l);
        } catch (e) {}
      });
    });
  })();
</script>
