---
/** Строка стека «Стек: …» для карточки опыта — весь стек компании (из реестра навыков).
 *  Если компания есть в фильтре навыков (linkCompany) — добавляем ссылку в секцию
 *  навыков с фильтром по ней (структурированный просмотр по группам). */
import { UI } from '../lib/labels';
import Bilingual from './Bilingual.astro';

interface Props {
  stack: string[];
  linkCompany?: string;
}
const { stack, linkCompany } = Astro.props;
---

{
  stack.length > 0 && (
    <p class="tl-stackline">
      <span class="tl-stacklabel">
        <Bilingual ru={UI.stack.ru} en={UI.stack.en} />:
      </span>{' '}
      {stack.join(', ')}
      {linkCompany && (
        <a class="tl-stack-skills" href="#skills" data-company={linkCompany}>
          <Bilingual ru="Смотреть навыки →" en="View skills →" />
        </a>
      )}
    </p>
  )
}
