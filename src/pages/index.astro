---
import { loadContent, loadTargets } from '../lib/load';
import { variantSlug } from '../lib/slug';
import { withBase } from '../lib/url';
import { absUrl } from '../lib/canonical';
import { byPriority, byStartDesc } from '../lib/compose';
import { renderInline } from '../lib/inline';
import { contactIcon, ICON_EMAIL } from '../lib/icons';
import { YANDEX_COUNTER_ID } from '../lib/analytics';
import { SECTION_TITLES } from '../lib/labels';
import ExperienceItem from '../components/ExperienceItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LangToggle from '../components/LangToggle.astro';
import Bilingual from '../components/Bilingual.astro';
import type { Localized, SkillItem } from '../schema/index';
import '../styles/landing.css';

const content = loadContent();
const base = import.meta.env.BASE_URL;

const { profile } = content;
const name = profile.name.ru; // язык документа по умолчанию — ru

// Tagline для hero: человеко-ориентированный general-вариант (с фолбэком).
const variantsByPriority = [...content.summary.variants].sort(byPriority);
const tagline =
  content.summary.variants.find((v) => v.id === 'summary-general') ?? variantsByPriority[0];

// Топ ключевых результатов по priority.
const results = [...content.achievements.items].sort(byPriority).slice(0, 6);

const skillGroups = [...content.skills.groups].sort(byPriority);

// Опыт — по дате начала по убыванию (новейшее сверху), как в основном резюме.
const experience = [...content.experience].sort(byStartDesc);

// Логотипы компаний для hero-полосы: уникальные, в порядке от новейшего опыта.
const companyLogos = experience
  .filter((e) => e.logo)
  .reduce<{ company: string; logo: string; expId: string }[]>((acc, e) => {
    if (!acc.some((c) => c.company === e.company)) {
      // expId — id первого (новейшего) места работы этой компании: якорь для скролла.
      acc.push({ company: e.company, logo: e.logo!, expId: e.id });
    }
    return acc;
  }, []);

// Личные увлечения — только для лендинга, по priority по убыванию.
const interests = [...content.interests.items].sort(byPriority);

// Продающая полоса цифр и лидерские тезисы — только лендинг, по priority по убыванию.
const stats = [...content.stats.items].sort(byPriority);
const theses = [...content.theses.items].sort(byPriority);

// Скачиваемый PDF: берём самый полный «человеческий» вариант — rich + hr + без
// отбора по тегам (это hh). С фолбэком, если такого таргета нет.
const targets = loadTargets();
const pdfTarget =
  targets.find(
    (t) =>
      t.formats.includes('pdf') &&
      t.layout === 'rich' &&
      t.audience === 'hr' &&
      Object.keys(t.select ?? {}).length === 0,
  ) ??
  targets.find((t) => t.formats.includes('pdf') && t.layout === 'rich') ??
  targets.find((t) => t.formats.includes('pdf'));
// Опрятное имя файла при скачивании (латиница — не все браузеры дружат с кириллицей в download).
const pdfNameBase = profile.name.en.replace(/\s+/g, '_');
const pdfHref = (lang: 'ru' | 'en') =>
  pdfTarget && pdfTarget.languages.includes(lang)
    ? withBase(base, `generated/${variantSlug(pdfTarget.id, lang)}.pdf`)
    : null;
const pdfRu = pdfHref('ru');
const pdfEn = pdfHref('en');

// Telegram для закрывающего CTA (если задан в профиле).
const telegram = profile.links.find((l) => l.kind === 'telegram');

/** Навык: языко-нейтральная строка либо двуязычный термин. */
const isLocalized = (x: SkillItem): x is Localized => typeof x !== 'string';

const year = new Date().getFullYear();

// Контакт-иконки вынесены в src/lib/icons.ts (SVG, наследуют цвет чипа).

// Абсолютные URL для SEO/AI (портируемо: из Astro.site + base).
const site = Astro.site;
const pageUrl = absUrl(site, base, '');
const mdRu = absUrl(site, base, 'ru/resume.md');
const mdEn = absUrl(site, base, 'en/resume.md');
const llmsUrl = absUrl(site, base, 'llms.txt');
const jsonEn = absUrl(site, base, 'en/resume.json');
// OG-карточка 1200×630 генерится в dist/og.png (scripts/build-og.ts, шаг build:og).
const ogImage = absUrl(site, base, 'og.png');

// Мета-описание: короткий pitch (фолбэк — tagline). Соцсети/Google режут длинные.
const metaDesc = profile.pitch?.ru ?? tagline.text.ru;
// og:title держим ≤60 симв.: имя + короткая роль (до разделителя « · »).
const roleShort = profile.title.ru.split(' · ')[0];
const ogTitle = `${name} — ${roleShort}`;
const siteName = 'kusokbanana.ru';

// JSON-LD schema.org Person — факты прямо в HTML для ИИ/поисковиков.
const current = experience[0]; // новейшее место работы
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name.en,
  alternateName: profile.name.ru,
  jobTitle: profile.title.en,
  description: tagline.text.en,
  email: profile.email ? `mailto:${profile.email}` : undefined,
  url: pageUrl,
  address: profile.location
    ? { '@type': 'PostalAddress', addressLocality: profile.location.en }
    : undefined,
  sameAs: profile.links.map((l) => l.url),
  worksFor: current
    ? { '@type': 'Organization', name: current.company, url: current.companyUrl }
    : undefined,
  knowsLanguage: content.languages.items.map((l) => l.name.en),
  knowsAbout: profile.keywords?.en,
  alumniOf: content.education.items.map((e) => ({
    '@type': 'CollegeOrUniversity',
    name: e.institution.en,
  })),
};
---

<BaseLayout title={`${name} — резюме`} dataLang>
  <Fragment slot="head">
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="google-site-verification" content="av7FBCkzLKf20h9nwG9qptHSQe7fj6RBNwrTKG6zNT4" />
    <meta name="yandex-verification" content="5872f59cc3bd95f6" />
    <link rel="alternate" type="text/markdown" hreflang="ru" href={mdRu} />
    <link rel="alternate" type="text/markdown" hreflang="en" href={mdEn} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={llmsUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Помечаем, что JS активен (включает сворачивание опыта и reveal-анимации).
      document.documentElement.classList.add('js');
      // Язык до отрисовки тела — без мигания. Приоритет: явный выбор из
      // localStorage → иначе язык браузера (en → английский, всё прочее → ru-дефолт).
      (function () {
        try {
          var l = localStorage.getItem('landing-lang');
          if (l !== 'en' && l !== 'ru') {
            var nav = (navigator.language || navigator.userLanguage || '').toLowerCase();
            l = nav.indexOf('en') === 0 ? 'en' : 'ru';
          }
          document.documentElement.dataset.lang = l;
          document.documentElement.setAttribute('lang', l);
        } catch (e) {}
      })();
    </script>
  </Fragment>
    <header class="nav">
      <a class="brand" href={withBase(base)}>
        <img class="mono" src={withBase(base, 'favicon.svg')} width="34" height="34" alt="" />
        <span class="brand-name" aria-hidden="true">
          <Bilingual ru={profile.name.ru} en={profile.name.en} />
        </span>
      </a>
      <LangToggle />
    </header>

    <main class="wrap">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-main">
            <p class="eyebrow">
              <Bilingual ru="Открыт к предложениям" en="Open to opportunities" />
            </p>
            <h1>
              <Bilingual ru={profile.name.ru} en={profile.name.en} />
            </h1>
            <p class="title">
              <Bilingual ru={profile.title.ru} en={profile.title.en} />
            </p>
            {
              profile.location && (
                <p class="location">
                  <Bilingual ru={profile.location.ru} en={profile.location.en} />
                </p>
              )
            }
            <p class="tagline">
              <Bilingual ru={tagline.text.ru} en={tagline.text.en} />
            </p>

            <div class="contacts">
              {
                profile.email && (
                  <a class="chip" href={`mailto:${profile.email}`} data-goal="contact_email">
                    <span class="ico" set:html={ICON_EMAIL} />
                    <Bilingual ru="Почта" en="Email" />
                  </a>
                )
              }
              {
                profile.links.map((l) => (
                  <a
                    class="chip"
                    href={l.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-goal={`contact_${l.kind ?? 'link'}`}
                  >
                    <span class="ico" set:html={contactIcon(l.kind)} />
                    {l.label}
                  </a>
                ))
              }
            </div>

            <div class="cta-row">
              <a class="btn btn-primary" href="#results">
                <Bilingual ru="Ключевые результаты" en="Key results" />
              </a>
              <a class="btn btn-ghost" href="#experience">
                <Bilingual ru="Опыт работы" en="Experience" />
              </a>
              {
                pdfRu && (
                  <a
                    class="btn btn-ghost lang-ru"
                    href={pdfRu}
                    download={`${pdfNameBase}_CV_ru.pdf`}
                    data-goal="download_pdf"
                  >
                    Скачать PDF
                  </a>
                )
              }
              {
                pdfEn && (
                  <a
                    class="btn btn-ghost lang-en"
                    href={pdfEn}
                    download={`${pdfNameBase}_CV_en.pdf`}
                    data-goal="download_pdf"
                  >
                    Download PDF
                  </a>
                )
              }
            </div>
          </div>

          <div class="hero-portrait">
            <div class="portrait-frame">
              {
                profile.photo ? (
                  <img
                    class="portrait-img"
                    src={withBase(base, profile.photo)}
                    alt={profile.name.ru}
                    loading="eager"
                  />
                ) : (
                  <div class="portrait-fallback" aria-hidden="true">
                    SD
                  </div>
                )
              }
            </div>
          </div>
        </div>

        {
          companyLogos.length > 0 && (
            <div class="logos">
              <span class="logos-label">
                <Bilingual ru="Опыт в компаниях" en="Experience at" />
              </span>
              <div class="logos-row">
                {companyLogos.map((c) => (
                  <a class="logo" href={`#exp-${c.expId}`} title={c.company}>
                    <img src={withBase(base, c.logo)} alt={c.company} loading="lazy" />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </section>

      <!-- ПОЛОСА ЦИФР -->
      {
        stats.length > 0 && (
          <section class="stats-band reveal" aria-label="Ключевые цифры">
            {stats.map((s) => (
              <div class="stat">
                <div class="stat-value">
                  <span class="lang-ru" data-count>
                    {s.value.ru}
                  </span>
                  <span class="lang-en" data-count>
                    {s.value.en}
                  </span>
                </div>
                <div class="stat-label">
                  <Bilingual ru={s.label.ru} en={s.label.en} />
                </div>
              </div>
            ))}
          </section>
        )
      }

      <!-- ТЕЗИСЫ -->
      {
        theses.length > 0 && (
          <section class="theses" aria-label="Принципы">
            {theses.map((t) => (
              <p class="thesis reveal">
                <Bilingual ru={renderInline(t.text.ru)} en={renderInline(t.text.en)} html />
              </p>
            ))}
          </section>
        )
      }

      <!-- РЕЗУЛЬТАТЫ -->
      <section class="section" id="results">
        <div class="section-head reveal">
          <span class="num">01</span>
          <h2>
            <Bilingual ru={SECTION_TITLES.achievements.ru} en={SECTION_TITLES.achievements.en} />
          </h2>
        </div>
        <div class="results">
          {
            results.map((a) => (
              <article class="result reveal">
                <div class="body">
                  <Bilingual ru={renderInline(a.text.ru)} en={renderInline(a.text.en)} html />
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- ОПЫТ -->
      <section class="section" id="experience">
        <div class="section-head reveal">
          <span class="num">02</span>
          <h2>
            <Bilingual ru={SECTION_TITLES.experience.ru} en={SECTION_TITLES.experience.en} />
          </h2>
        </div>
        <div class="timeline">
          {experience.map((e) => <ExperienceItem e={e} base={base} />)}
        </div>
      </section>

      <!-- НАВЫКИ -->
      <section class="section" id="skills">
        <div class="section-head reveal">
          <span class="num">03</span>
          <h2>
            <Bilingual ru={SECTION_TITLES.skills.ru} en={SECTION_TITLES.skills.en} />
          </h2>
        </div>
        <div class="skill-groups">
          {
            skillGroups.map((g) => (
              <div class="skill-group reveal">
                <h3>
                  <Bilingual ru={g.name.ru} en={g.name.en} />
                </h3>
                <div class="tags">
                  {g.items.map((it) =>
                    isLocalized(it) ? (
                      <span class="tag">
                        <Bilingual ru={it.ru} en={it.en} />
                      </span>
                    ) : (
                      <span class="tag">{it}</span>
                    ),
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      {
        interests.length > 0 && (
          <section class="section" id="beyond">
            <div class="section-head reveal">
              <span class="num">04</span>
              <h2>
                <Bilingual ru="Помимо работы" en="Beyond work" />
              </h2>
            </div>
            <p class="beyond-lead">
              <Bilingual
                ru="Заряжаюсь там, где нужны фокус, баланс и немного смелости."
                en="I recharge where focus, balance and a bit of courage are required."
              />
            </p>
            <div class="interests">
              {interests.map((it) =>
                it.photo ? (
                  <button
                    class="interest interest-clickable reveal"
                    type="button"
                    data-photo={withBase(base, it.photo)}
                    data-caption-ru={it.label.ru}
                    data-caption-en={it.label.en}
                  >
                    {it.icon && (
                      <span class="interest-ico" aria-hidden="true">
                        {it.icon}
                      </span>
                    )}
                    <Bilingual ru={it.label.ru} en={it.label.en} />
                    <span class="interest-zoom" aria-hidden="true">⤢</span>
                  </button>
                ) : (
                  <span class="interest reveal">
                    {it.icon && (
                      <span class="interest-ico" aria-hidden="true">
                        {it.icon}
                      </span>
                    )}
                    <Bilingual ru={it.label.ru} en={it.label.en} />
                  </span>
                ),
              )}
            </div>
            {
              profile.instagram && (
                <a
                  class="beyond-link reveal"
                  href={profile.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="beyond-link-ico" aria-hidden="true">
                    ✦
                  </span>
                  <Bilingual ru="Больше личного" en="A bit more personal" />
                  <span class="beyond-link-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              )
            }
          </section>
        )
      }

      <!-- ЗАКРЫВАЮЩИЙ CTA -->
      <section class="cta-final reveal" id="contact">
        <h2>
          <Bilingual
            ru="Открыт к роли Head of Engineering"
            en="Open to a Head of Engineering role"
          />
        </h2>
        <p>
          <Bilingual
            ru="Строю и масштабирую сильные инженерные команды. Давайте обсудим, чем могу быть полезен."
            en="I build and scale strong engineering teams. Let's talk about how I can help."
          />
        </p>
        <div class="cta-row">
          {
            profile.email && (
              <a class="btn btn-primary" href={`mailto:${profile.email}`} data-goal="cta_email">
                <Bilingual ru="Написать на почту" en="Email me" />
              </a>
            )
          }
          {
            telegram && (
              <a
                class="btn btn-ghost"
                href={telegram.url}
                target="_blank"
                rel="noopener noreferrer"
                data-goal="cta_telegram"
              >
                <Bilingual ru="Написать в Telegram" en="Message on Telegram" />
              </a>
            )
          }
          {
            pdfRu && (
              <a
                class="btn btn-ghost lang-ru"
                href={pdfRu}
                download={`${pdfNameBase}_CV_ru.pdf`}
                data-goal="cta_download_pdf"
              >
                Скачать PDF
              </a>
            )
          }
          {
            pdfEn && (
              <a
                class="btn btn-ghost lang-en"
                href={pdfEn}
                download={`${pdfNameBase}_CV_en.pdf`}
                data-goal="cta_download_pdf"
              >
                Download PDF
              </a>
            )
          }
        </div>
      </section>

      <footer class="footer">
        <span class="copy">
          © {year}
          <Bilingual ru={profile.name.ru} en={profile.name.en} />
        </span>
        <!-- Машиночитаемая версия: видимый указатель для ИИ-ассистентов
             (которые читают рендер, а не <head>) и сигнал «как данные» для людей. -->
        <span class="machine">
          <Bilingual ru="Это резюме доступно как данные:" en="This resume is available as data:" />
          <a href={llmsUrl}>llms.txt</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={mdEn}>Markdown</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={jsonEn}>JSON Resume</a>
        </span>
      </footer>
    </main>

    <!-- Лайтбокс для фото увлечений (наполняется по клику на чип). -->
    <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
      <button class="lightbox-close" type="button" aria-label="Close">×</button>
      <figure class="lightbox-fig">
        <img class="lightbox-img" src="" alt="" />
        <figcaption class="lightbox-cap"></figcaption>
      </figure>
    </div>

    <script define:vars={{ YM_ID: YANDEX_COUNTER_ID }}>
      // Аналитика кликов: любой элемент с data-goal шлёт цель в Яндекс.Метрику
      // и событие в GA4. Оба необязательны. YM_ID приходит из src/lib/analytics.ts.
      (function () {
        document.addEventListener('click', function (ev) {
          var el = ev.target && ev.target.closest ? ev.target.closest('[data-goal]') : null;
          if (!el) return;
          var goal = el.getAttribute('data-goal');
          try {
            if (window.gtag) window.gtag('event', goal);
          } catch (e) {}
          try {
            if (window.ym) window.ym(YM_ID, 'reachGoal', goal);
          } catch (e) {}
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var html = document.documentElement;
        // Переключение языка вынесено в LangToggle.astro.
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // --- Сворачивание опыта: всё видимо без JS; здесь сворачиваем и вешаем тоггл.
        document.querySelectorAll('.tl-toggle').forEach(function (btn) {
          var rest = btn.parentElement.querySelector('.tl-rest');
          if (!rest) return;
          rest.classList.add('is-collapsed');
          rest.style.maxHeight = '0px';
          btn.addEventListener('click', function () {
            var open = btn.getAttribute('aria-expanded') === 'true';
            if (open) {
              // Свернуть: фиксируем текущую высоту, затем уводим в 0 (для анимации).
              rest.style.maxHeight = rest.scrollHeight + 'px';
              requestAnimationFrame(function () {
                rest.classList.add('is-collapsed');
                rest.style.maxHeight = '0px';
              });
              btn.setAttribute('aria-expanded', 'false');
            } else {
              rest.classList.remove('is-collapsed');
              rest.style.maxHeight = rest.scrollHeight + 'px';
              btn.setAttribute('aria-expanded', 'true');
            }
          });
          // После разворота снимаем фиксированную высоту — чтобы контент мог
          // переразмечаться (напр. при переключении языка).
          rest.addEventListener('transitionend', function (ev) {
            if (ev.propertyName === 'max-height' && !rest.classList.contains('is-collapsed')) {
              rest.style.maxHeight = 'none';
            }
          });
        });

        // --- Появление при скролле.
        var revealables = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window)) {
          revealables.forEach(function (el) {
            el.classList.add('in');
          });
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in');
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          revealables.forEach(function (el) {
            io.observe(el);
          });
        }

        // --- Имя в шапке проявляется, когда крупное имя из hero ушло за верх.
        var navEl = document.querySelector('.nav');
        var heroName = document.querySelector('.hero h1');
        if (navEl && heroName) {
          if (!('IntersectionObserver' in window)) {
            navEl.classList.add('scrolled');
          } else {
            var navIo = new IntersectionObserver(
              function (entries) {
                navEl.classList.toggle('scrolled', !entries[0].isIntersecting);
              },
              // Отрицательный top ≈ высоте шапки: срабатывает, когда имя
              // уходит под неё, а не когда полностью покидает вьюпорт.
              { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
            );
            navIo.observe(heroName);
          }
        }

        // --- Count-up для полосы цифр: докручиваем числовой префикс от 0.
        // Без анимации значения уже в DOM (важно для no-JS/reduce-motion/SEO).
        var band = document.querySelector('.stats-band');
        if (band && !reduce && 'IntersectionObserver' in window) {
          // У каждого числа парсим ведущий целый префикс: «50+»→50, «91%»→91,
          // «10+ лет»→10. Если целого префикса нет («1,5×») — оставляем как есть.
          var counters = [];
          band.querySelectorAll('[data-count]').forEach(function (el) {
            var full = el.textContent;
            var m = /^(\d+)/.exec(full.trim());
            if (!m) return;
            var suffix = full.trim().slice(m[1].length); // «+», «%», « лет»…
            // Дробные («1,5×», «1.5×») не крутим — 0→1 смотрится странно.
            if (/^[.,]/.test(suffix)) return;
            var target = parseInt(m[1], 10);
            counters.push({ el: el, target: target, suffix: suffix });
            el.textContent = '0' + suffix;
          });
          if (counters.length) {
            var DURATION = 850;
            var animate = function (start) {
              var step = function (now) {
                var p = Math.min((now - start) / DURATION, 1);
                var eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
                counters.forEach(function (c) {
                  c.el.textContent = Math.round(eased * c.target) + c.suffix;
                });
                if (p < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            };
            var cio = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    cio.unobserve(entry.target);
                    requestAnimationFrame(function (t) {
                      animate(t);
                    });
                  }
                });
              },
              { threshold: 0.35 },
            );
            cio.observe(band);
          }
        }

        // --- Лайтбокс фото увлечений.
        var lb = document.getElementById('lightbox');
        if (lb) {
          var lbImg = lb.querySelector('.lightbox-img');
          var lbCap = lb.querySelector('.lightbox-cap');
          var lastFocused = null;
          function openLightbox(src, capRu, capEn, alt) {
            lbImg.setAttribute('src', src);
            lbImg.setAttribute('alt', alt || '');
            lbCap.innerHTML = '';
            var sru = document.createElement('span');
            sru.className = 'lang-ru';
            sru.textContent = capRu || '';
            var sen = document.createElement('span');
            sen.className = 'lang-en';
            sen.textContent = capEn || '';
            lbCap.appendChild(sru);
            lbCap.appendChild(sen);
            lb.classList.add('open');
            lb.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
          function closeLightbox() {
            lb.classList.remove('open');
            lb.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            lbImg.setAttribute('src', '');
            if (lastFocused) lastFocused.focus();
          }
          document.querySelectorAll('.interest-clickable').forEach(function (btn) {
            btn.addEventListener('click', function () {
              lastFocused = btn;
              openLightbox(
                btn.getAttribute('data-photo'),
                btn.getAttribute('data-caption-ru'),
                btn.getAttribute('data-caption-en'),
                btn.getAttribute('data-caption-' + (html.dataset.lang || 'ru')),
              );
            });
          });
          lb.addEventListener('click', function (ev) {
            // Клик по фону/крестику (не по самому фото) — закрыть.
            if (ev.target === lb || ev.target.classList.contains('lightbox-close')) {
              closeLightbox();
            }
          });
          document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape' && lb.classList.contains('open')) closeLightbox();
          });
        }
      })();
    </script>
</BaseLayout>
