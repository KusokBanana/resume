---
import { loadContent } from '../../lib/load';
import { globalSkillGroups } from '../../lib/compose';
import { SECTION_TITLES, dateRange, formatMonths } from '../../lib/labels';
import {
  evidenceForSkill,
  totalMonths,
  orderedCompanies,
  collectAtIds,
} from '../../lib/skill-evidence';
import Bilingual from '../Bilingual.astro';

const content = loadContent();
const { experience } = content;
const groups = globalSkillGroups(content.skills);

// Fail-fast: любой `at` в реестре должен ссылаться на существующий id опыта.
const validIds = new Set(experience.map((e) => e.id));
const badId = collectAtIds(content.skills.items).find((id) => !validIds.has(id));
if (badId) {
  throw new Error(
    `skills.yaml: привязка at="${badId}" не совпадает ни с одним id из experience (${[...validIds].join(', ')})`,
  );
}

// Компании (новейшие первыми) + карта имя→ключ для data-co (по ВСЕМ — чипы ссылаются
// на любые). Кнопки фильтра — только 3 новейшие (PT / VK / Яндекс), ранние не показываем.
const companies = orderedCompanies(experience);
const keyOf = new Map(companies.map((c) => [c.name, c.key]));
const filterCompanies = companies.slice(0, 4);
---

<section class="section" id="skills">
  <div class="section-head reveal">
    <span class="num">03</span>
    <h2>
      <Bilingual ru={SECTION_TITLES.skills.ru} en={SECTION_TITLES.skills.en} />
    </h2>
  </div>

  {
    /* Фильтр по компании — прогрессивное улучшение: показывается только под html.js
     (без скрипта кнопки бесполезны), логика — в landing.ts. */
  }
  <div class="skill-filter reveal" role="group" aria-label="Фильтр навыков по компании">
    <button class="co-btn is-active" type="button" data-co="" aria-pressed="true">
      <Bilingual ru="Все" en="All" />
    </button>
    {
      filterCompanies.map((c) => (
        <button
          class="co-btn"
          type="button"
          data-co={c.key}
          aria-pressed="false"
          title={c.name}
        >
          {c.label}
        </button>
      ))
    }
  </div>

  <div class="skill-groups">
    {
      groups.map((g) => (
        <div class="skill-group reveal">
          <h3>
            <Bilingual ru={g.name.ru} en={g.name.en} />
          </h3>
          <div class="tags">
            {g.items.map((s) => {
              const ev = evidenceForSkill(s, experience);
              const co = [...new Set(ev.map((e) => keyOf.get(e.company)!))].join(' ');
              const months = totalMonths(ev);
              /* Кнопка + <template> с содержимым поповера — смежные соседи:
                 landing.ts берёт шаблон через nextElementSibling. */
              return (
                <>
                  <button
                    type="button"
                    class="tag has-pop"
                    data-co={co}
                    aria-expanded="false"
                    aria-haspopup="dialog"
                  >
                    {s.name ? s.name : <Bilingual ru={s.ru!} en={s.en!} />}
                  </button>
                  <template class="tag-pop">
                    <p class="skill-pop-head">
                      <strong>
                        {s.name ? s.name : <Bilingual ru={s.ru!} en={s.en!} />}
                      </strong>
                      <span class="skill-pop-total">
                        <Bilingual
                          ru={formatMonths(months, 'ru')}
                          en={formatMonths(months, 'en')}
                        />
                      </span>
                    </p>
                    <ul class="skill-pop-list">
                      {ev.map((e) => (
                        <li>
                          <a href={`#exp-${e.id}`} data-short={e.short}>
                            {e.company}
                          </a>
                          <Bilingual
                            class="skill-pop-period"
                            ru={dateRange(e.start, e.end, 'ru')}
                            en={dateRange(e.start, e.end, 'en')}
                          />
                        </li>
                      ))}
                    </ul>
                  </template>
                </>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</section>
