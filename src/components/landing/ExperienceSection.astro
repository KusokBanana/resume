---
import { loadContent } from '../../lib/load';
import { byStartDesc, stackFor } from '../../lib/compose';
import { orderedCompanies } from '../../lib/skill-evidence';
import { SECTION_TITLES } from '../../lib/labels';
import ExperienceItem from '../ExperienceItem.astro';
import Bilingual from '../Bilingual.astro';

// Опыт — по дате начала по убыванию (новейшее сверху), как в основном резюме.
const content = loadContent();
const experience = [...content.experience].sort(byStartDesc);
const base = import.meta.env.BASE_URL;

// Компании, доступные в фильтре навыков (3 новейшие) — только у их карточек в стеке
// будет ссылка «по группам →» в секцию навыков.
const filterNames = new Set(
  orderedCompanies(content.experience)
    .slice(0, 4)
    .map((c) => c.name),
);
---

<section class="section" id="experience">
  <div class="section-head reveal">
    <span class="num">02</span>
    <h2>
      <Bilingual ru={SECTION_TITLES.experience.ru} en={SECTION_TITLES.experience.en} />
    </h2>
  </div>
  <div class="timeline">
    {
      experience.map((e) => (
        <ExperienceItem
          e={e}
          base={base}
          stack={stackFor(content.skills, e.id)}
          linkCompany={filterNames.has(e.company) ? e.company : undefined}
        />
      ))
    }
  </div>
</section>
