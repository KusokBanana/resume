{
  "name": "resume",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Резюме как код: единый источник истины, мульти-таргет сборка (HTML/PDF/MD) на GitHub Pages",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "tsx --test test/*.test.ts",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,astro}\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro}\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "validate": "tsx scripts/validate.ts",
    "build:md": "tsx scripts/build-md.ts",
    "build:json": "tsx scripts/build-json.ts",
    "build:txt": "tsx scripts/build-txt.ts",
    "build:pdf": "tsx scripts/build-pdf.ts",
    "build:og": "tsx scripts/build-og.ts",
    "build:favicons": "tsx scripts/build-favicons.ts",
    "build:all": "npm run build && npm run build:md && npm run build:json && npm run build:txt && npm run build:pdf && npm run build:og",
    "tailor": "tsx cli/tailor.ts",
    "cover-letter": "tsx cli/cover-letter.ts",
    "find-jobs": "tsx cli/find-jobs.ts",
    "apply": "tsx cli/apply.ts"
  },
  "dependencies": {
    "astro": "^7.0.6",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.13.2",
    "openai": "^6.45.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
