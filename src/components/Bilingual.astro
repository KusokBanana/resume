---
/**
 * Двуязычная пара элементов: по одному на язык, оба всегда в DOM, а CSS по
 * data-lang на <html> показывает нужный. Убирает повторяющуюся ручную разметку
 * `<span class="lang-ru">…</span><span class="lang-en">…</span>`.
 *
 * - `as` — тег каждого элемента (по умолчанию `span`; напр. `li` для пунктов).
 * - `class` — доп. классы, добавляются к `lang-ru`/`lang-en`.
 * - `html` — вставить значения как HTML (set:html), если в тексте разметка
 *   (напр. **жирный** через renderInline), иначе — как текст.
 * - Прочие атрибуты (data-*, aria-* и т.п.) пробрасываются на оба элемента.
 */
interface Props {
  ru: string;
  en: string;
  html?: boolean;
  as?: string;
  class?: string;
  [key: string]: unknown;
}
const { ru, en, html = false, as: Tag = 'span', class: className, ...rest } = Astro.props;
const ruClass = ['lang-ru', className].filter(Boolean).join(' ');
const enClass = ['lang-en', className].filter(Boolean).join(' ');
---

{
  html ? (
    <>
      <Tag class={ruClass} {...rest} set:html={ru} />
      <Tag class={enClass} {...rest} set:html={en} />
    </>
  ) : (
    <>
      <Tag class={ruClass} {...rest}>
        {ru}
      </Tag>
      <Tag class={enClass} {...rest}>
        {en}
      </Tag>
    </>
  )
}
